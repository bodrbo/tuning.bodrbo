Options -Indexes
DirectoryIndex index.html index.php
AddDefaultCharset UTF-8

ErrorDocument 404 /404.html

# Репозиторий разворачивается напрямую в public_html. Не отдаём Git-метаданные
# посетителям, даже если они запросят известный путь вручную.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Данные админки, резервные копии и PHP-библиотека не являются публичными.
  RewriteRule ^content(?:/|$) - [F,L,NC]
  RewriteRule ^(?:content-functions|admin-config(?:\.example)?)\.php$ - [R=404,L,NC]

  # Единственное главное зеркало сайта — без www, на основном домене.
  RewriteCond %{HTTP_HOST} ^(?:www\.bodrbo-tuning\.ru|tuning\.bodrbo\.ru)$ [NC]
  RewriteRule ^ https://bodrbo-tuning.ru%{REQUEST_URI} [R=301,L,NE]

  RewriteRule "(^|/)\.git(/|$)" - [R=404,L,NC]

  # Старые технические URL перенаправляем на постоянные человекопонятные адреса.
  # THE_REQUEST не даёт внутренним правилам ниже зациклить редиректы.
  RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
  RewriteRule ^index\.html$ / [R=301,L,NE]

  RewriteCond %{THE_REQUEST} \s/+projects\.html(?:[?\s]) [NC]
  RewriteRule ^projects\.html$ /proekty/ [R=301,L,NE]

  RewriteCond %{THE_REQUEST} \s/+projects\.php(?:[?\s]) [NC]
  RewriteRule ^projects\.php$ /proekty/ [R=301,L,NE,QSD]

  RewriteCond %{THE_REQUEST} \s/+sitemap\.php(?:[?\s]) [NC]
  RewriteRule ^sitemap\.php$ /sitemap.xml [R=301,L,NE,QSD]

  RewriteCond %{THE_REQUEST} \s/+motors\.html(?:[?\s]) [NC]
  RewriteRule ^motors\.html$ /lodochnye-motory-marine-rocket/ [R=301,L,NE]

  RewriteCond %{THE_REQUEST} \s/+privacy\.html(?:[?\s]) [NC]
  RewriteRule ^privacy\.html$ /privacy/ [R=301,L,NE]

  RewriteCond %{THE_REQUEST} \s/+motor\.php(?:[?\s]) [NC]
  RewriteRule ^motor\.php$ /lodochnye-motory-marine-rocket/ [R=301,L,NE,QSD]

  RewriteCond %{THE_REQUEST} \s/+project\.html\? [NC]
  RewriteCond %{QUERY_STRING} (^|&)case=recovery(&|$) [NC]
  RewriteRule ^project\.html$ /proekty/vosstanovlenie-katera-posle-utopleniya/ [R=301,L,NE,QSD]

  RewriteCond %{THE_REQUEST} \s/+project\.html\? [NC]
  RewriteCond %{QUERY_STRING} (^|&)case=mariah(&|$) [NC]
  RewriteRule ^project\.html$ /proekty/tyuning-katera-mariah-s21le/ [R=301,L,NE,QSD]

  RewriteCond %{THE_REQUEST} \s/+project\.html\? [NC]
  RewriteCond %{QUERY_STRING} (^|&)case=macgregor(&|$) [NC]
  RewriteRule ^project\.html$ /proekty/pokraska-yakhty-macgregor-26/ [R=301,L,NE,QSD]

  RewriteCond %{THE_REQUEST} \s/+project\.html\? [NC]
  RewriteCond %{QUERY_STRING} (^|&)case=salut(&|$) [NC]
  RewriteRule ^project\.html$ /proekty/tyuning-katera-salyut-585nt/ [R=301,L,NE,QSD]

  RewriteCond %{THE_REQUEST} \s/+project\.html\? [NC]
  RewriteCond %{QUERY_STRING} (^|&)case=gladius(&|$) [NC]
  RewriteRule ^project\.html$ /proekty/remont-falshkilya-gladius-520/ [R=301,L,NE,QSD]

  RewriteCond %{THE_REQUEST} \s/+project\.html(?:[?\s]) [NC]
  RewriteRule ^project\.html$ /proekty/ [R=301,L,NE,QSD]

  RewriteCond %{THE_REQUEST} \s/+project\.php(?:[?\s]) [NC]
  RewriteRule ^project\.php$ /proekty/ [R=301,L,NE,QSD]

  # Адреса опубликованных страниц прежнего сайта на Tilda.
  RewriteRule ^tk/?$ /proekty/tyuning-katera-mariah-s21le/ [R=301,L,NE]
  RewriteRule ^tm/?$ /proekty/pokraska-yakhty-macgregor-26/ [R=301,L,NE]
  RewriteRule ^tg/?$ /proekty/remont-falshkilya-gladius-520/ [R=301,L,NE]
  RewriteRule ^ts/?$ /proekty/tyuning-katera-salyut-585nt/ [R=301,L,NE]
  RewriteRule ^soon/?$ /proekty/ [R=301,L,NE]
  RewriteRule ^vosstanovlenie-katera-posle-utopleniya/?$ /proekty/vosstanovlenie-katera-posle-utopleniya/ [R=301,L,NE]

  # У всех публичных разделов один канонический формат — с завершающим слешем.
  RewriteRule ^proekty$ /proekty/ [R=301,L,NE]
  RewriteRule ^privacy$ /privacy/ [R=301,L,NE]
  RewriteRule ^lodochnye-motory-marine-rocket$ /lodochnye-motory-marine-rocket/ [R=301,L,NE]
  RewriteRule ^lodochnye-motory-marine-rocket/([a-z0-9]+(?:-[a-z0-9]+)*)$ /lodochnye-motory-marine-rocket/$1/ [R=301,L,NE]
  RewriteRule ^proekty/([a-z0-9]+(?:-[a-z0-9]+)*)$ /proekty/$1/ [R=301,L,NE]

  # Чистые URL обслуживаются существующими HTML-шаблонами без изменения адреса.
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
  RewriteRule ^sitemap-motory\.xml$ motor-sitemap.php [L]
  RewriteRule ^privacy/?$ privacy.html [L]
  RewriteRule ^proekty/?$ projects.php [L]
  RewriteRule ^lodochnye-motory-marine-rocket/?$ motors.html [L]
  RewriteRule ^lodochnye-motory-marine-rocket/([a-z0-9]+(?:-[a-z0-9]+)*)/?$ motor.php?slug=$1 [L,QSA]
  RewriteRule ^proekty/([a-z0-9]+(?:-[a-z0-9]+)*)/?$ project.php?slug=$1 [L,QSA]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set X-Frame-Options "DENY"
</IfModule>

<IfModule mod_authz_core.c>
  <FilesMatch "^(?:admin-config|integration-config)\.php$">
    Require all denied
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 5 minutes"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
</IfModule>
